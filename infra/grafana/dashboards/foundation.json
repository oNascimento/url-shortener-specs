{
  "uid": "shortener-foundation",
  "title": "Shortener — Aplicação",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "traceId",
        "type": "textbox",
        "label": "Trace ID",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Logs por traceId (vazio mostra todos)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"shortener-.+\"} | trace_id =~ \".*${traceId:regex}.*\""
        }
      ]
    },
    {
      "id": 2,
      "title": "Requisições por serviço",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(shortener_requests_total[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latência p95 por serviço (s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(shortener_request_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Respostas 5xx por serviço",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(shortener_requests_total{status=~\"5..\"}[5m]))"
        }
      ]
    }
  ]
}
